# =============================================================================
# IP SHAP frontend — copy to .env.local (never commit secrets)
# Full matrix: documentation/ENVIRONMENT.md
# =============================================================================

# --- Public (safe for the browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = local/demo fixtures OK | false = required in production (P6+)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (P1+) — use STAGING keys locally; never mix with production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact — confirmed values live in .env.local / Vercel (see PLATFORM_BOOTSTRAP.md)
# Her WhatsApp (Contact us): local 0790801271 → +250790801271
# NEXT_PUBLIC_WHATSAPP_E164=+250790801271
# His voice line: local 0788937270 → +250788937270
# NEXT_PUBLIC_PHONE_E164=+250788937270
# NEXT_PUBLIC_CONTACT_EMAIL=patrickiradukunda505@gmail.com
# NEXT_PUBLIC_ADDRESS=
# NEXT_PUBLIC_OPENING_HOURS=08:00–20:00

# Bot protection / monitoring (P8) — when TURNSTILE_SECRET_KEY is set, forms require a token
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_SENTRY_DSN=
# Optional source-map upload in CI: SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN

# --- Server-only (never NEXT_PUBLIC_*) ---
SUPABASE_SERVICE_ROLE_KEY=

# Admin bootstrap (local / break-glass until P2 Supabase Auth)
# Generate long random values — never commit real secrets.
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
# ADMIN_BOOTSTRAP_EMAIL=

# Staff new-order email (P5) — Rosine + Patrick
# ORDER_NOTIFY_EMAILS=yadufashijerosine@gmail.com,patrickiradukunda505@gmail.com
# Resend requires a verified domain (not raw Gmail) for EMAIL_FROM
# EMAIL_FROM=IP SHAP Orders <orders@your-verified-domain>
# RESEND_API_KEY=

# TURNSTILE_SECRET_KEY=
# SENTRY_DSN=

# Same as public WhatsApp (server deep links)
# WHATSAPP_BUSINESS_E164=+250790801271

# Payments — MoMo out of handover scope; keep disabled
ONLINE_PAYMENT_ENABLED=false
PAYMENT_PROVIDER=unselected
# PAYMENT_WEBHOOK_SECRET=
