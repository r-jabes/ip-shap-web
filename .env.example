# IP SHAP frontend — copy to .env.local (never commit secrets)
# Staging host: set the same keys in Vercel → Project → Settings → Environment Variables
# Docs: documentation/ENVIRONMENT.md

# --- Public ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
# Google Search Console HTML-tag verification content (not a secret). Paste in Vercel for production.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WHATSAPP_E164=+250790801271
NEXT_PUBLIC_PHONE_E164=+250788937270
NEXT_PUBLIC_CONTACT_EMAIL=patrickiradukunda505@gmail.com
NEXT_PUBLIC_ADDRESS=29 KK 218 St, Kigali, Rwanda
NEXT_PUBLIC_OPENING_HOURS=08:00–20:00

# --- Server-only ---
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
WHATSAPP_BUSINESS_E164=+250790801271
ORDER_NOTIFY_EMAILS=yadufashijerosine@gmail.com,patrickiradukunda505@gmail.com
EMAIL_FROM=
RESEND_API_KEY=
# Every email (staff alerts, back-in-stock, team invites, password resets) is sent from EMAIL_FROM
# through Resend with the IP SHAP branding. EMAIL_FROM must be an address on a domain verified in
# Resend, e.g. orders@the-ipshap.com (a display name is added automatically).
# Secret for the daily maintenance job (retries unsent emails, emails shoppers waiting for a
# restocked drink, releases stock held by unconfirmed orders after 3 days, deletes old data).
# 16+ random characters. Vercel Cron sends it automatically.
CRON_SECRET=
ONLINE_PAYMENT_ENABLED=false
PAYMENT_PROVIDER=unselected
