# =============================================================================
# IP SHAP frontend — copy to .env.local (never commit secrets)
# Full matrix: documentation/ENVIRONMENT.md
# =============================================================================

# --- Public (safe for the browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = local/demo fixtures OK | false = required in production (P6+)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (P1+) — use STAGING keys locally; never mix with production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact (P7) — unset hides the field; never invent placeholders
# Her WhatsApp (Contact us)
# NEXT_PUBLIC_WHATSAPP_E164=+2507XXXXXXXX
# His voice line
# NEXT_PUBLIC_PHONE_E164=+2507XXXXXXXX
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_ADDRESS=
# NEXT_PUBLIC_OPENING_HOURS=

# Bot protection / monitoring (P8)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Server-only (never NEXT_PUBLIC_*) ---
SUPABASE_SERVICE_ROLE_KEY=

# Admin bootstrap (local / break-glass until P2 Supabase Auth)
# Generate long random values — never commit real secrets.
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
# ADMIN_BOOTSTRAP_EMAIL=

# Staff new-order email (P5)
# ORDER_NOTIFY_EMAILS=owner1@example.com,owner2@example.com
# EMAIL_FROM=orders@example.com
# RESEND_API_KEY=

# TURNSTILE_SECRET_KEY=
# SENTRY_DSN=

# Contact WhatsApp digits server-side if needed (usually same as public)
# WHATSAPP_BUSINESS_E164=2507XXXXXXXX

# Payments — MoMo out of handover scope; keep disabled
ONLINE_PAYMENT_ENABLED=false
PAYMENT_PROVIDER=unselected
# PAYMENT_WEBHOOK_SECRET=
