# Public (safe for the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contact facts — unset hides the field (never invent placeholders)
# NEXT_PUBLIC_WHATSAPP_E164=+2507XXXXXXXX
# NEXT_PUBLIC_PHONE_E164=+2507XXXXXXXX
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_ADDRESS=
# NEXT_PUBLIC_OPENING_HOURS=

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Admin bootstrap (local / until Supabase Auth + admin_profiles is live)
# Generate long random values — never commit real secrets.
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
# Optional: restrict bootstrap login to one email
ADMIN_BOOTSTRAP_EMAIL=

# Orders / WhatsApp (server-only)
# E.164 digits, e.g. 2507XXXXXXXX — unset until the business confirms
WHATSAPP_BUSINESS_E164=
# Keep false until a Rwanda-capable provider is verified
ONLINE_PAYMENT_ENABLED=false
# unselected | sandbox (sandbox is test-only — never label as live)
PAYMENT_PROVIDER=unselected
# HMAC secret for /api/payments/webhook (≥ 16 chars when using sandbox)
PAYMENT_WEBHOOK_SECRET=
